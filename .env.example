# DuskDex — variáveis de ambiente do backend PHP.
# Copie para ".env" (na raiz do projeto) e ajuste. Nunca versione o arquivo .env real.

APP_ENV=local            # local | production
APP_DEBUG=true           # nunca true em produção (exibe detalhes de erro)
APP_URL=http://127.0.0.1:8080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=duskdex
# XAMPP padrão: usuário root sem senha. Em produção, crie um usuário próprio com senha forte.
DB_USERNAME=root
DB_PASSWORD=

# Sessão
SESSION_NAME=DDSESSID
SESSION_SECURE=auto      # auto = Secure somente em HTTPS
SESSION_REMEMBER_DAYS=30

# Rate limit de login (janela de 15 minutos)
RATE_LOGIN_PER_ACCOUNT=8
RATE_LOGIN_PER_IP=30

# Integração TCGdex: o servidor valida cartas pela base local; a API pública é só reserva
TCGDEX_BASE=https://api.tcgdex.net/v2
TCGDEX_TIMEOUT=6

# Arquivos enviados (imagens) e e-mails em modo "log" ficam aqui — FORA da pasta pública.
# Padrão: <raiz do projeto>/storage
# STORAGE_PATH=/caminho/para/storage
ASSET_QUOTA_MB=500       # limite da biblioteca de imagens por usuário

# E-mail (links de redefinir senha e confirmar e-mail usam APP_URL acima)
# MAIL_DRIVER:
#   log  — modo de teste: NÃO envia; grava em storage/mail. O site mostra "Confirmar agora" (só fora de produção).
#   smtp — envia de verdade por um servidor SMTP (ex.: Gmail, abaixo).
#   mail — função mail() do PHP (hospedagens como HostGator/cPanel).
MAIL_DRIVER=log
MAIL_FROM=no-reply@duskdex.local
MAIL_FROM_NAME=DuskDex
# --- Exemplo com Gmail (precisa da verificação em duas etapas ligada e de uma "senha de app":
#     myaccount.google.com/apppasswords). Tire o "#" das linhas abaixo, troque MAIL_DRIVER para smtp
#     e teste com: php backend/bin/test-mail.php seu@email.com
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_ENCRYPTION=tls
# MAIL_USERNAME=seuemail@gmail.com
# MAIL_PASSWORD="abcd efgh ijkl mnop"
# Só se aparecer erro de "conexão segura" no Windows/XAMPP:
# MAIL_CA_FILE=C:\xampp\apache\bin\curl-ca-bundle.crt

# Comunidade
REQUIRE_VERIFIED_EMAIL=false   # true = só quem confirmou o e-mail publica e comenta
RATE_POSTS_PER_HOUR=20
RATE_COMMENTS_PER_HOUR=60
RATE_TRADES_PER_DAY=30
RATE_UPLOADS_PER_HOUR=120

# Base local de cartas (gerada por tools/build-catalog.mjs). Padrão: frontend/data/catalog
# CATALOG_PATH=/caminho/para/frontend/data/catalog
